{
  "name": "@modulos/core-inventory",
  "version": "1.0.0",
  "description": "Módulo agnóstico de lógica de dominio pura para gestión de inventarios, almacenes, kardex contable, valoración FIFO/CMP, lotes, series y tomas físicas.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "inventory",
    "stock",
    "almacen",
    "warehouse",
    "kardex",
    "fifo",
    "cmp",
    "pos",
    "domain-driven-design"
  ],
  "author": "rilokuau",
  "license": "MIT",
  "dependencies": {
    "@modulos/core-shared": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1"
  }
}
