{
  "name": "@modulos/core-cashier",
  "version": "1.0.0",
  "description": "Módulo agnóstico de lógica de dominio pura para gestión de cajas, turnos, movimientos, cobros y arqueos.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cashier",
    "caja",
    "pos",
    "arqueo",
    "turnos",
    "finanzas",
    "domain-driven-design"
  ],
  "author": "rilokuau",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
