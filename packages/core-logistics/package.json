{
  "name": "@modulos/core-logistics",
  "version": "1.0.0",
  "description": "Módulo agnóstico de dominio puro para logística y entregas: envíos, máquina de estados, cotización de tarifas en centavos, repartidores, rutas y prueba de entrega (POD).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "logistics",
    "delivery",
    "shipping",
    "routes",
    "pod",
    "tracking",
    "domain-driven-design"
  ],
  "author": "RanVer Developers",
  "license": "MIT",
  "dependencies": {
    "@modulos/core-shared": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1"
  }
}
