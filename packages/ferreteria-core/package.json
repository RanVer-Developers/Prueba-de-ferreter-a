{
  "name": "@ferreteria/core",
  "version": "1.0.0",
  "description": "Orquestador headless de dominio y persistencia local para Ferreteria y Materiales El Tornillo Fuerte",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modulos/core-auth-rbac": "workspace:*",
    "@modulos/core-cashier": "workspace:*",
    "@modulos/core-catalog": "workspace:*",
    "@modulos/core-customers": "workspace:*",
    "@modulos/core-inventory": "workspace:*",
    "@modulos/core-logistics": "workspace:*",
    "@modulos/core-orders": "workspace:*",
    "@modulos/core-purchasing": "workspace:*",
    "@modulos/core-reports": "workspace:*",
    "@modulos/core-settings": "workspace:*",
    "@modulos/core-shared": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1"
  }
}
