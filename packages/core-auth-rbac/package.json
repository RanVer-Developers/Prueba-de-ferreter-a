{
  "name": "@modulos/core-auth-rbac",
  "version": "1.0.0",
  "description": "Módulo agnóstico de dominio puro para autenticación, sesiones, autorización RBAC granular, multi-tenant/sucursal y aprobación de supervisor.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "auth",
    "rbac",
    "authorization",
    "permissions",
    "sessions",
    "multi-tenant",
    "domain-driven-design"
  ],
  "author": "rilokuau",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
