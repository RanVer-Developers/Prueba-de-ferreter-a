  "keywords": [
    "services",
    "work-orders",
    "workshop",
    "warranty",
    "cutting",
    "domain-driven-design"
  ],
  "author": "RanVer Developers",
  "license": "MIT",
  "dependencies": {
    "@modulos/core-shared": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1"
  }
}
