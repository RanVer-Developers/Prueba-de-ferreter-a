{
  "name": "@modulos/core-services",
  "version": "1.0.0",
  "description": "Módulo agnóstico de dominio para órdenes de servicio, taller, maquila/corte, garantías, mano de obra y consumo de refacciones.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
